// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
  runtime      = "bun"
}

datasource db {
  provider = "postgresql"
}

/**
 * User → Playlist = One-to-Many
 * Playlist → PlaylistItem = One-to-Many
 * Song → PlaylistItem = One-to-Many
 * Artist → Song = One-to-Many
 * Artist ↔ Song through ArtistSong = Many-to-Many
 */

model User {
  userId           String    @id @default(dbgenerated("gen_random_uuid()")) @map("user_id")
  email            String    @unique @map("email") @db.VarChar(255)
  passwordHash     String    @map("password_hash")
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime? @updatedAt @map("updated_at") @db.Timestamptz(6)
  lastLogin        DateTime? @map("last_login") @db.Timestamptz(6)
  subscriptionType String?   @map("subscription_type")
  country          String?   @map("country")

  // Relations
  playlists Playlist[]

  @@map("users")
}

model Playlist {
  playlistId String    @id @default(dbgenerated("gen_random_uuid()")) @map("playlist_id")
  ownerId    String    @map("owner_id")
  name       String    @map("name")
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime? @updatedAt @map("updated_at") @db.Timestamptz(6)

  // Relations
  owner         User           @relation(fields: [ownerId], references: [userId])
  playlistItems PlaylistItem[]

  @@map("playlists")
}

model PlaylistItem {
  playlistId String    @map("playlist_id")
  songId     String    @map("song_id")
  position   Int       @map("position")
  addedAt    DateTime  @default(now()) @map("added_at") @db.Timestamptz(6)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime? @updatedAt @map("updated_at") @db.Timestamptz(6)

  // Relations
  playlist Playlist @relation(fields: [playlistId], references: [playlistId])
  song     Song     @relation(fields: [songId], references: [songId])

  @@id([playlistId, songId])
  @@map("playlist_items")
}

model Song {
  songId      String    @id @default(dbgenerated("gen_random_uuid()")) @map("song_id")
  title       String    @map("title")
  genre       String?   @map("genre")
  duration    Int       @map("duration")
  releaseDate DateTime? @map("release_date") @db.Date
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime? @updatedAt @map("updated_at") @db.Timestamptz(6)
  artistId    String    @map("artist_id")
  albumId     String?   @map("album_id")
  status      String    @default("PENDING") @map("status")

  // Relations
  artist        Artist         @relation(fields: [artistId], references: [artistId])
  album         Album?         @relation(fields: [albumId], references: [albumId])
  playlistItems PlaylistItem[]
  artistSongs   ArtistSong[]

  @@map("songs")
}

model Artist {
  artistId  String    @id @default(dbgenerated("gen_random_uuid()")) @map("artist_id")
  name      String    @map("name") @db.VarChar(100)
  country   String?   @map("country")
  bio       String?   @map("bio")
  imageUrl  String?   @map("image_url")
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime? @updatedAt @map("updated_at") @db.Timestamptz(6)

  // Relations
  songs       Song[]
  artistSongs ArtistSong[]
  albums      Album[]

  @@map("artists")
}

model Album {
  albumId     String    @id @default(dbgenerated("gen_random_uuid()")) @map("album_id")
  title       String    @map("title")
  releaseDate DateTime? @map("release_date") @db.Date
  artistId    String    @map("artist_id")
  isDefault   Boolean   @default(false) @map("is_default")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime? @updatedAt @map("updated_at") @db.Timestamptz(6)

  // Relations
  artist Artist @relation(fields: [artistId], references: [artistId])
  songs  Song[]

  @@map("albums")
}

// Explicit Many to Many relation
model ArtistSong {
  songId    String    @map("song_id")
  artistId  String    @map("artist_id")
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime? @updatedAt @map("updated_at") @db.Timestamptz(6)

  // Relations
  song   Song   @relation(fields: [songId], references: [songId], onDelete: Cascade)
  artist Artist @relation(fields: [artistId], references: [artistId], onDelete: Cascade)

  @@id([songId, artistId])
  @@map("artists_songs")
}
